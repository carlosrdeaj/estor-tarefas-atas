entrypoint = "server/index.ts"
modules = ["nodejs-20", "web"]
run = "npm install && npm run dev"
hidden = [".git", "node_modules", "dist", "data"]

[nix]
channel = "stable-24_05"
packages = ["sqlite"]

[env]
PORT = "5000"

[deployment]
deploymentTarget = "vm"
build = ["npm", "run", "build"]
run = ["npm", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Projeto"

[[workflows.workflow]]
name = "Projeto"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npm run dev"
waitForPort = 5000
